---
layout: base.njk
permalink: /embed/index.html
title: Intégration
---

<header class="detail-head">
	<h2 class="page-hed">Intégrer un score</h2>
	<p class="lede">
		Un élément personnalisé autonome qui affiche les scores Lighthouse d’un site
		et renvoie vers son rapport complet. Ajoutez-le à n’importe quelle page :
		il ne nécessite que le script et l’URL de cette instance.
	</p>
</header>

<script type="module" src="/js/speedlify2-score.js"></script>

{% set measured = [] %}
{% for entry in sites.entries %}
	{% if entry.latest %}{% set measured = (measured.push(entry), measured) %}{% endif %}
{% endfor %}

{# L’URL épinglée est recherchée plutôt que considérée comme acquise : si elle ne figure plus dans le corpus, la première entrée mesurée est utilisée. #}
{% set pinned = [] %}
{% for entry in measured %}
	{% if entry.url == "https://arielsalminen.com/" %}{% set pinned = (pinned.push(entry), pinned) %}{% endif %}
{% endfor %}
{% set featured = pinned[0] or measured[0] %}

{# Chaque site dispose d’une intégration (src/site-filmstrip.11tydata.js), et le site mis en avant est proposé par défaut. #}
{% set strips = [] %}
{% set stripSlugs = [] %}
{% for entry in [featured].concat(sites.entries) %}
	{% if entry and entry.slug not in stripSlugs %}
		{% set strips = (strips.push(entry), strips) %}
		{% set stripSlugs = (stripSlugs.push(entry.slug), stripSlugs) %}
	{% endif %}
{% endfor %}

{% from "contents.njk" import contents %}
{% set toc = [
	{ id: "try", label: "Aperçu interactif" },
	{ id: "usage", label: "Utilisation" },
	{ id: "finding-data", label: "Comment les données sont trouvées" }
] %}
{% if strips.length %}{% set toc = (toc.push({ id: "filmstrip", label: "Bande de captures" }), toc) %}{% endif %}
{{ contents(toc) }}

<section class="panel" id="try">
	<h2>Aperçu interactif</h2>
	<p class="muted small">
		Sélectionnez un site mesuré ou saisissez une URL pour voir le rendu du
		composant sur cette instance. Survolez les scores ou placez-y le focus
		du clavier pour afficher son résumé.
	</p>

	{% if featured %}
	<form class="race-picker embed-picker" id="score-embed-picker" autocomplete="off">
		<fieldset disabled title="JavaScript est nécessaire pour choisir un site.">
			<div class="race-field">
				<label class="race-field-label" for="score-embed-site">Site</label>
				<input class="race-field-input" id="score-embed-site" type="url" list="score-embed-catalog" value="{{ featured.url }}">
			</div>
			<datalist id="score-embed-catalog">
				{% for entry in measured | sort(false, false, "displayUrl") %}<option value="{{ entry.url }}"></option>{% endfor %}
			</datalist>
		</fieldset>
	</form>
	<p class="embed-live" id="score-embed-preview">
		<speedlify2-score speedlify-url="{{ '/' | htmlBaseUrl }}" url="{{ featured.url }}"></speedlify2-score>
	</p>
	<pre><code id="score-embed-code" data-origin="{{ meta.url }}/">&lt;speedlify2-score speedlify-url="{{ meta.url }}/" url="{{ featured.url }}"&gt;&lt;/speedlify2-score&gt;</code></pre>
	<script>
	(function () {
		var form = document.getElementById("score-embed-picker");
		var input = document.getElementById("score-embed-site");
		var preview = document.getElementById("score-embed-preview");
		var code = document.getElementById("score-embed-code");
		var fieldset = form.querySelector("fieldset");

		// Le composant ne lit ses attributs qu’à sa connexion : pour afficher un autre site, il faut créer un nouvel élément.
		function choose(url, write) {
			var current = preview.querySelector("speedlify2-score");
			var next = document.createElement("speedlify2-score");
			next.setAttribute("speedlify-url", current.getAttribute("speedlify-url"));
			next.setAttribute("url", url);
			current.replaceWith(next);
			input.value = url;
			code.textContent = '<speedlify2-score speedlify-url="' + code.dataset.origin + '" url="' + url + '"></speedlify2-score>';
			if (write) {
				var address = new URL(location.href);
				address.searchParams.set("url", url);
				address.hash = "try";
				history.replaceState(null, "", address);
			}
		}

		function parse(value) {
			try {
				var url = new URL(value.trim());
				return /^https?:$/.test(url.protocol) ? url.href : null;
			} catch (e) {
				return null;
			}
		}

		input.addEventListener("change", function () {
			var url = parse(input.value);
			if (url) {
				input.removeAttribute("aria-invalid");
				choose(url, true);
			} else {
				input.setAttribute("aria-invalid", "true");
			}
		});
		form.addEventListener("submit", function (event) {
			event.preventDefault();
		});

		var linked = parse(new URLSearchParams(location.search).get("url") || "");
		if (linked) choose(linked, false);

		fieldset.disabled = false;
		fieldset.removeAttribute("title");
	})();
	</script>
	{% endif %}
</section>

<section class="panel" id="usage">
	<h2>Utilisation</h2>

	<p>Installez le paquet depuis npm : cette version est épinglée et hébergée sur votre propre site :</p>

	<pre><code>npm install speedlify2-score</code></pre>

	<p>Importez-le une seule fois, où que ce soit dans votre bundle. L’élément s’enregistre automatiquement :</p>

	<pre><code>import "speedlify2-score";</code></pre>

	<p class="muted small">
		Aucune dépendance, un seul fichier et un module ES standard : aucune étape
		de compilation n’est nécessaire. <a href="https://www.npmjs.com/package/speedlify2-score">speedlify2-score sur npm</a> ·
		<a href="https://github.com/zachleat/speedlify2/tree/main/packages/speedlify2-score">code source</a>
	</p>

	<p>
		Vous pouvez aussi éviter l’installation et télécharger le fichier manuellement :
		<a href="{{ meta.url }}/js/speedlify2-score.js"><code>{{ meta.url }}/js/speedlify2-score.js</code></a>
	</p>

	<div class="notice notice-warn">
		<strong>Il est déconseillé d’inclure directement le script du composant speedlify2-score depuis un autre site.</strong>
		<p>
			Le JavaScript tiers est à éviter ! Cette copie intégrée directement n’offre
			aucune gestion de versions, aucune politique de dépréciation et aucune
			garantie de disponibilité : le fichier peut être modifié, déplacé ou ne
			plus être distribué à tout moment. Une page qui l’intègre directement
			<strong>pourrait alors ne plus fonctionner, sans avertissement.</strong>
			En l’installant depuis npm, vous contrôlez la version utilisée.
		</p>
	</div>

	<p>Quelle que soit la méthode de chargement, le balisage reste le même :</p>

	<pre><code>&lt;!-- Si vous n’utilisez pas de bundle, indiquez ici le chemin vers votre propre copie --&gt;
&lt;script type="module" src="speedlify2-score.js"&gt;&lt;/script&gt;

&lt;!-- Scores de la page où se trouve l’élément --&gt;
&lt;speedlify2-score speedlify-url="{{ meta.url }}/"&gt;&lt;/speedlify2-score&gt;

&lt;!-- Ou scores d’une URL précise --&gt;
&lt;speedlify2-score speedlify-url="{{ meta.url }}/" url="https://example.com/"&gt;&lt;/speedlify2-score&gt;</code></pre>

	<h3>Attributs</h3>
	<p class="muted small">
		Deux attributs, dont un seul est facultatif. Le rendu n’est pas
		personnalisable : chaque instance affiche les mêmes six cercles — les
		quatre catégories Lighthouse, les Core Web Vitals et les violations
		d’accessibilité détectées par axe. Ainsi, plusieurs instances sur une page
		forment un tableau cohérent plutôt qu’une série de graphiques différents.
		Tout le reste est accessible en un clic dans le rapport complet.
	</p>
	<div class="table-scroll">
	<table class="grid">
		<thead>
			<tr><th class="col-site">Attribut</th><th class="col-site">Effet</th></tr>
		</thead>
		<tbody>
			<tr><td class="col-site"><code>speedlify-url</code></td><td class="col-site">Obligatoire. URL de cette instance.</td></tr>
			<tr><td class="col-site"><code>url</code></td><td class="col-site">Site à afficher. Par défaut, la page actuelle.</td></tr>
		</tbody>
	</table>
	</div>
</section>

<section class="panel" id="finding-data">
	<h2>Comment les données sont trouvées</h2>
	<p class="muted small">
		Aucun index n’est à télécharger. Dans le navigateur, le composant transforme
		l’URL en slug à l’aide des mêmes règles que le générateur, puis récupère
		directement <code>/api/site/&lt;slug&gt;.json</code>. Une seule requête,
		de moins d’un kilooctet, pour le site affiché.
	</p>
	<p class="muted small">
		Plusieurs composants présents sur une même page partagent une seule requête
		par URL. La normalisation correspond à celle du générateur : ainsi,
		<code>https://Example.com</code> et <code>https://example.com/</code>
		donnent accès au même enregistrement.
	</p>
	<p class="muted small">
		Le calcul du nom de fichier repose sur des manipulations de chaînes de
		caractères, et non sur la cryptographie. Le composant n’a donc pas besoin
		d’un contexte sécurisé et fonctionne aussi sur une page servie en HTTP
		non chiffré. Si deux sites obtiennent un jour le même slug, ils sont tous
		deux publiés avec un hachage et apparaissent ici comme non mesurés : le
		résultat est une absence de données, jamais les scores d’un autre site.
	</p>
	<p class="muted small">
		<a href="/api/site/{{ featured.slug }}.json">Voir le fichier de données de {{ featured.displayUrl }}</a>
	</p>
</section>

{% if strips.length %}
{% set strip = strips[0] %}
<section class="panel" id="filmstrip">
	<h2>Intégrer une bande de captures</h2>
	<p class="muted small">
		Chaque site dispose d’une copie animée de sa bande de captures à
		<code>/site/&lt;slug&gt;/filmstrip/</code>, dimensionnée pour une iframe,
		ou d’une bande vide si aucune capture n’a été réalisée. Aucun script n’est
		nécessaire sur votre page : l’animation démarre lorsque la bande entre dans
		la zone visible. Ajoutez <code>?theme=light</code> ou
		<code>?theme=dark</code> pour remplacer le thème système du lecteur.
	</p>
	{# Désactivé jusqu’à l’activation de JavaScript, comme le sélecteur de catégorie de l’en-tête. #}
	<form class="race-picker embed-picker" id="filmstrip-embed-picker" autocomplete="off">
		<fieldset disabled title="JavaScript est nécessaire pour choisir un site.">
			<div class="race-field">
				<label class="race-field-label" for="filmstrip-embed-site">Site</label>
				<input class="race-field-input" id="filmstrip-embed-site" type="text" list="filmstrip-embed-catalog" value="{{ strip.displayUrl }}">
			</div>
			<datalist id="filmstrip-embed-catalog">
				{% for entry in strips | sort(false, false, "displayUrl") %}<option value="{{ entry.displayUrl }}" data-slug="{{ entry.slug }}"></option>{% endfor %}
			</datalist>
		</fieldset>
	</form>
	<iframe class="filmstrip-embed-frame" id="filmstrip-embed-frame" src="/site/{{ strip.slug }}/filmstrip/" title="Bande de captures de {{ strip.displayUrl }}" loading="lazy"
		data-base="{{ '/' | htmlBaseUrl }}"></iframe>
	<pre><code id="filmstrip-embed-code" data-origin="{{ meta.url }}/">&lt;iframe src="{{ meta.url }}/site/{{ strip.slug }}/filmstrip/" title="Bande de captures de {{ strip.displayUrl }}" width="100%" height="420" style="border: 0" loading="lazy"&gt;&lt;/iframe&gt;</code></pre>
	<script>
	(function () {
		var form = document.getElementById("filmstrip-embed-picker");
		var input = document.getElementById("filmstrip-embed-site");
		var frame = document.getElementById("filmstrip-embed-frame");
		var code = document.getElementById("filmstrip-embed-code");
		var options = document.querySelectorAll("#filmstrip-embed-catalog option");
		var fieldset = form.querySelector("fieldset");

		function find(typed) {
			typed = typed.trim().toLowerCase();
			for (var i = 0; i < options.length; i++) {
				if (options[i].value.toLowerCase() === typed || options[i].dataset.slug === typed) return options[i];
			}
			return null;
		}

		function choose(option, write) {
			var slug = option.dataset.slug;
			var name = option.value;
			var path = "site/" + slug + "/filmstrip/";
			input.value = name;
			input.removeAttribute("aria-invalid");
			frame.src = frame.dataset.base + path;
			frame.title = "Bande de captures de " + name;
			code.textContent = '<iframe src="' + code.dataset.origin + path + '" title="Bande de captures de ' + name + '" width="100%" height="420" style="border: 0" loading="lazy"></iframe>';
			if (write) {
				var url = new URL(location.href);
				url.searchParams.set("site", slug);
				url.hash = "filmstrip";
				history.replaceState(null, "", url);
			}
		}

		input.addEventListener("change", function () {
			var option = find(input.value);
			if (option) choose(option, true);
			else input.setAttribute("aria-invalid", "true");
		});
		form.addEventListener("submit", function (event) {
			event.preventDefault();
		});

		var linked = find(new URLSearchParams(location.search).get("site") || "");
		if (linked) choose(linked, false);

		fieldset.disabled = false;
		fieldset.removeAttribute("title");
	})();
	</script>
</section>
{% endif %}