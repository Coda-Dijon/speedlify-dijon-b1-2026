{#
	La navigation fixe « Sur cette page », générée à partir d’une liste d’entrées `{ id, label }` qui pointent vers des sections de la page.

	https://github.com/zachleat/table-of-contents — les entrées pointent vers des sections plutôt que vers des titres ; c’est donc ces sections qui sont suivies.
#}
{% macro contents(toc) %}
{% if toc.length > 1 %}
<nav class="contents contents-sticky" aria-label="Sur cette page">
	<span class="contents-label">Sur cette page</span>
	<table-of-contents selector="{% for item in toc %}#{{ item.id }}{{ ', ' if not loop.last }}{% endfor %}">
	<ul>
		{% for item in toc %}
		<li><a href="#{{ item.id }}">{{ item.label }}</a></li>
		{% endfor %}
	</ul>
	</table-of-contents>
</nav>
{% endif %}
{% endmacro %}