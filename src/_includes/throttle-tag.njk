{#- Des émojis plutôt que Font Awesome : les icônes correspondantes sont réservées à la version Pro. Décoratifs — le texte porte le sens. #}
{% macro throttleTag(kind, title) %}
{%- if kind == "throttled" %} <span class="tag" title="{{ title or "Mesuré avec une connexion et un processeur réellement ralentis : le chargement est donc lent." }}"><span class="tag-mark" aria-hidden="true">🐢</span> Ralentissement réel</span>
{%- elif kind == "unthrottled" %} <span class="tag tag-quiet" title="{{ title or "Mesuré directement lors d’un chargement à pleine vitesse, avant toute simulation de ralentissement par Lighthouse : ces valeurs sont donc plus rapides que les estimations affichées à côté." }}"><span class="tag-mark" aria-hidden="true">🐇</span> Sans ralentissement</span>
{%- elif kind == "simulated" %} <span class="tag tag-quiet" title="{{ title or "Simulation de ralentissement par défaut de Lighthouse : la page a été chargée à pleine vitesse, puis ces valeurs ont été estimées comme si elle avait été chargée sur un téléphone lent avec une connexion lente." }}"><span class="tag-mark" aria-hidden="true">🤖</span> Simulé</span>
{%- endif -%}
{% endmacro %}

{#- Méthode de capture de la bande de vignettes, commune à la page du site et à son intégration. #}
{% macro filmstripThrottleTag(filmstrip) %}
{%- if filmstrip.throttled === true %}{{ throttleTag("throttled", "Capturée avec une connexion et un processeur réellement ralentis : ces images montrent donc un chargement lent.") }}
{%- elif filmstrip.throttled === false %}{{ throttleTag("unthrottled", "Capturée avec la simulation de ralentissement par défaut de Lighthouse, qui ne ralentit pas le navigateur : la page a été chargée à pleine vitesse et les métriques ont été estimées ensuite. Ces images montrent un chargement rapide.") }}
{%- endif -%}
{% endmacro %}